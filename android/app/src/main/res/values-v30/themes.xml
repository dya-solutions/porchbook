<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 11+: declared see-through so the founder's peep hole can show the home screen behind;
         the app turns itself solid at start (setTranslucent(false)) and only goes see-through while peeping. -->
    <style name="Theme.Porch" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="colorPrimary">@color/pine</item>
        <item name="colorAccent">@color/pine</item>
    </style>
</resources>
